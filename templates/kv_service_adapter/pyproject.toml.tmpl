[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = "{{distribution}}"
version = "0.1.0.dev0"
description = "{{display_name}} external KV Provider for vLLM-HUST"
readme = "README.md"
requires-python = ">=3.10"
license = "Apache-2.0"
dependencies = ["vllm-hust-ext==0.2.0.dev0"]

[project.optional-dependencies]
test = ["pytest>=8", "ruff>=0.12"]

[project.entry-points."vllm_hust.extension_bundles"]
"{{extension_id}}" = "{{module}}.manifests"

[project.entry-points."vllm_hust_ext.providers"]
"{{provider_name}}" = "{{module}}.provider:{{class_name}}Provider"

[tool.hatch.build.targets.wheel]
packages = ["src/{{module}}"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
target-version = "py310"
line-length = 88

[tool.ruff.lint]
select = ["B", "E", "F", "I", "SIM", "UP"]
