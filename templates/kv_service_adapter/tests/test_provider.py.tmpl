from pathlib import Path

from vllm_hust_ext.manifest import load_manifest

from {{module}}.provider import {{class_name}}Provider


def test_provider_plan_is_non_mutating_and_operator_owned() -> None:
    manifest_path = (
        Path(__file__).parents[1]
        / "src"
        / "{{module}}"
        / "manifests"
        / "vllm-hust-extension-v0.3.json"
    )
    manifest = load_manifest(manifest_path)
    plan = {{class_name}}Provider().plan(
        manifest,
        {"connector": "ExampleConnector", "health_url": "http://127.0.0.1:9"},
        enabled=True,
    )

    assert manifest.bundle_id == "{{extension_id}}"
    assert manifest.schema_version == "0.3-experimental"
    assert manifest.lifecycle_owner == "external_operator"
    assert all(not action.mutating for action in plan.actions)
    assert plan.generated_config["kv_transfer_config"]["kv_connector"] == (
        "ExampleConnector"
    )
