from pathlib import Path

from vllm_hust_ext.manifest import activation_blocker, load_manifest

import {{module}}


def test_descriptor_is_discoverable_but_not_activatable() -> None:
    manifest = load_manifest(
        Path({{module}}.__file__).with_name("vllm-hust-extension-v0.2.json")
    )
    assert manifest.bundle_id == "{{extension_id}}"
    assert activation_blocker(manifest) is not None
