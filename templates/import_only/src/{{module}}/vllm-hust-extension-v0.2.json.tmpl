{
  "schema_version": "0.2-experimental",
  "extension_id": "{{extension_id}}",
  "extension_version": "0.1.0.dev0",
  "kind": "in_process_plugin",
  "host": {
    "provider": "vllm",
    "name": "vllm",
    "version_range": ">=0"
  },
  "runtime": {
    "type": "python",
    "process_scope": "vllm-processes",
    "isolation": "trusted_in_process"
  },
  "lifecycle_owner": "vllm",
  "protocols": [
    {"name": "vllm.example.proposed-contract", "version_range": ">=1,<2"}
  ],
  "implementation": [
    {
      "type": "python_module",
      "module": "{{module}}",
      "object": "{{class_name}}ContractProposal",
      "status": "import_only"
    }
  ],
  "requires_services": [],
  "activation": {
    "entry_points": [],
    "environment": {},
    "additional_config": {}
  }
}
