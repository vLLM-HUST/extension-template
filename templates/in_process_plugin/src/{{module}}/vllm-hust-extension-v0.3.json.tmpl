    {"name": "vllm.general-plugin", "version_range": null}
  ],
  "implementation": [
    {
      "type": "python_module",
      "module": "{{module}}",
      "object": "register",
      "status": "active"
    }
  ],
  "requires_services": [],
  "requires_extensions": [],
