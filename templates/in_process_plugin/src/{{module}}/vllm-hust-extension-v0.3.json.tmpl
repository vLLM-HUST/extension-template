    {
      "resource": "vllm.worker.extension.example",
      "scope": "vllm-process",
      "mode": "exclusive"
    }
  ],
  "components": [
    {
      "component_id": "{{distribution}}",
      "contracts": ["vllm.general-plugin.experimental"],
      "execution_planes": ["worker"],
      "isolation": "trusted_in_process",
      "implementation_ref": "{{module}}:register",
      "permissions": []
    }
  ],
  "activation": {
    "entry_points": [
      {"group": "vllm.general_plugins", "name": "{{module}}"}
    ],
    "environment": {},
    "additional_config": {}
  }
