    "provider": "vllm",
    "name": "vllm",
    "version_range": ">=0",
    "api_range": ">=1,<2"
  },
  "runtime": {
    "type": "python",
    "process_scope": "worker",
    "isolation": "trusted_in_process"
  },
  "lifecycle_owner": "vllm",
